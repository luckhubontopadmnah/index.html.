                <button onclick="selectCategory('plastics', this)" class="cat-btn px-2.5 py-1 rounded text-[11px] font-medium bg-dark-800 hover:bg-dark-700 text-slate-300 whitespace-nowrap transition">Plásticos & Polímeros</button>
                <button onclick="selectCategory('organics', this)" class="cat-btn px-2.5 py-1 rounded text-[11px] font-medium bg-dark-800 hover:bg-dark-700 text-slate-300 whitespace-nowrap transition">Orgânicos & Tecidos</button>
            </div>

            <div class="flex-1 overflow-y-auto p-2 grid grid-cols-2 gap-1.5 content-start" id="element-list">
            </div>
        </aside>
    </div>

