            madeira: { id: 71, name: 'Madeira', color: '#78350f', type: 1, cat: 'organics', temp: 20 },
            carvao: { id: 72, name: 'Carvão', color: '#27272a', type: 2, cat: 'organics', temp: 20 },
            algodao: { id: 73, name: 'Algodão', color: '#fafafa', type: 2, cat: 'organics', temp: 20 },
            borracha: { id: 74, name: 'Borracha Natural', color: '#52525b', type: 1, cat: 'organics', temp: 20 }
        };

        const TYPE_MAP = new Uint8Array(256);
        const COLOR_CACHE = new Uint32Array(256);

        (function prepareCaches() {
            for (const el of Object.values(ELEMENTS)) {
                const hex = el.color;
                const r = parseInt(hex.slice(1, 3), 16);
                const g = parseInt(hex.slice(3, 5), 16);
                const b = parseInt(hex.slice(5, 7), 16);
                COLOR_CACHE[el.id] = (255 << 24) | (b << 16) | (g << 8) | r;
                TYPE_MAP[el.id] = el.type;
            }
            COLOR_CACHE[0] = (255 << 24) | (7 << 16) | (5 << 8) | 5;
        })();

        const grid = new Uint8Array(WIDTH * HEIGHT);
        const tempGrid = new Float32Array(WIDTH * HEIGHT);
        const hpGrid = new Uint8Array(WIDTH * HEIGHT);
        const updatedFlags = new Uint8Array(WIDTH * HEIGHT);

        tempGrid.fill(20);
        hpGrid.fill(100);

        let currentElementKey = 'humano';
        let brushSize = 3;
        let isPaused = false;
        let currentCategory = 'all';
        let heatViewActive = false;

        function populateElementList(filter = '') {
            const listEl = document.getElementById('element-list');
            listEl.innerHTML = '';

            for (const [key, el] of Object.entries(ELEMENTS)) {
                if (key === 'empty') continue;
                if (currentCategory !== 'all' && el.cat !== currentCategory) continue;
                if (filter && !el.name.toLowerCase().includes(filter.toLowerCase())) continue;

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = `flex items-center space-x-2 p-1.5 rounded-md bg-dark-950 hover:bg-dark-800 border text-left transition ${currentElementKey === key ? 'border-cyan-500 ring-1 ring-cyan-500 bg-dark-800' : 'border-dark-800'}`;

                btn.onclick = (e) => {
                    e.preventDefault();
                    selectElement(key);
                };

                const colorBox = document.createElement('div');
                colorBox.className = 'w-3.5 h-3.5 rounded shrink-0 shadow-sm border border-white/10 pointer-events-none';
                colorBox.style.backgroundColor = el.color;

                const nameSpan = document.createElement('span');
                nameSpan.className = 'text-[11px] text-slate-200 truncate font-medium pointer-events-none';
                nameSpan.innerText = el.name;

                btn.appendChild(colorBox);
                btn.appendChild(nameSpan);
                listEl.appendChild(btn);
            }
        }

        function selectElement(key) {
            currentElementKey = key;
            const el = ELEMENTS[key];
            if (el) document.getElementById('selected-indicator').innerText = el.name;
            populateElementList(document.getElementById('element-search').value);
        }

        function selectCategory(cat, btnElem) {
            currentCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(b => {
                b.classList.remove('bg-cyan-600', 'text-white');
                b.classList.add('bg-dark-800', 'text-slate-300');
            });

            if (btnElem) {
                btnElem.classList.remove('bg-dark-800', 'text-slate-300');
                btnElem.classList.add('bg-cyan-600', 'text-white');
            }

            populateElementList(document.getElementById('element-search').value);
        }

        function filterElements(val) {
            populateElementList(val);
        }

        function updateBrushSize(val) {
            brushSize = parseInt(val);
            document.getElementById('brush-size-val').innerText = brushSize;
        }

        function togglePause() {
            isPaused = !isPaused;
            document.getElementById('pause-icon').innerText = isPaused ? '▶️' : '⏸️';
            document.getElementById('pause-text').innerText = isPaused ? 'Continuar' : 'Pausar';
        }

        function toggleHeatView() {
            heatViewActive = !heatViewActive;
            document.getElementById('btn-heat-view').className = heatViewActive
                ? 'px-3 py-1 bg-amber-600 text-white rounded-lg text-xs font-semibold transition flex items-center gap-1 border border-amber-500 shadow'
                : 'px-3 py-1 bg-dark-800 hover:bg-dark-700 rounded-lg text-xs font-semibold transition flex items-center gap-1 border border-dark-700';

            document.getElementById('heat-view-text').innerText = heatViewActive ? 'Visão Térmica: ON' : 'Visão Térmica: OFF';
            document.getElementById('selected-indicator').innerText = heatViewActive ? 'Termografia' : ELEMENTS[currentElementKey].name;
        }

        function clearGrid() {
            grid.fill(0);
            tempGrid.fill(20);
            hpGrid.fill(100);
        }

        let isDrawing = false;

        function getCanvasCoords(clientX, clientY) {
            const rect = canvas.getBoundingClientRect();
            const x = Math.floor((clientX - rect.left) / (rect.width / WIDTH));
            const y = Math.floor((clientY - rect.top) / (rect.height / HEIGHT));
            return { x, y };
        }

        function paintBrush(cx, cy) {
            if (cx < 0 || cx >= WIDTH || cy < 0 || cy >= HEIGHT) return;

            const elObj = ELEMENTS[currentElementKey];
            if (!elObj) return;

            const r2 = brushSize * brushSize;

            for (let dy = -brushSize; dy <= brushSize; dy++) {
                for (let dx = -brushSize; dx <= brushSize; dx++) {
                    if (dx * dx + dy * dy <= r2) {
                        const nx = cx + dx;
                        const ny = cy + dy;

                        if (nx >= 0 && nx < WIDTH && ny >= 0 && ny < HEIGHT) {
                            const idx = ny * WIDTH + nx;
                            grid[idx] = elObj.id;
                            tempGrid[idx] = elObj.temp !== undefined ? elObj.temp : 20;
                            if (elObj.type === 6) hpGrid[idx] = 100;
                        }
                    }
                }
            }
        }

        function handlePointerDown(e) {
            isDrawing = true;
            const x = e.clientX ?? e.touches?.[0]?.clientX;
            const y = e.clientY ?? e.touches?.[0]?.clientY;
            if (x == null || y == null) return;

            const coords = getCanvasCoords(x, y);
            paintBrush(coords.x, coords.y);
            updateTooltip(e);
        }

        function handlePointerMove(e) {
            const x = e.clientX ?? e.touches?.[0]?.clientX;
            const y = e.clientY ?? e.touches?.[0]?.clientY;
            if (x == null || y == null) return;

            const coords = getCanvasCoords(x, y);
            if (isDrawing) paintBrush(coords.x, coords.y);
            updateTooltip(e);
        }

        function handlePointerUp() {
            isDrawing = false;
        }

        canvas.addEventListener('mousedown', handlePointerDown);
        window.addEventListener('mousemove', handlePointerMove);
        window.addEventListener('mouseup', handlePointerUp);

        canvas.addEventListener('touchstart', (e) => {
            handlePointerDown(e);
            e.preventDefault();
        }, { passive: false });

        canvas.addEventListener('touchmove', (e) => {
            handlePointerMove(e);
            e.preventDefault();
        }, { passive: false });

        window.addEventListener('touchend', handlePointerUp);

        function updateTooltip(e) {
            const clientX = e.clientX ?? e.touches?.[0]?.clientX;
            const clientY = e.clientY ?? e.touches?.[0]?.clientY;
            if (clientX == null || clientY == null) return;

            const coords = getCanvasCoords(clientX, clientY);

            if (coords.x >= 0 && coords.x < WIDTH && coords.y >= 0 && coords.y < HEIGHT) {
                const idx = coords.y * WIDTH + coords.x;
                const id = grid[idx];
                let name = 'Vazio';

                for (const el of Object.values(ELEMENTS)) {
                    if (el.id === id) {
                        name = el.name;
                        break;
                    }
                }

                const temp = Math.round(tempGrid[idx]);
                document.getElementById('tooltip').innerText =
                    `Elemento: ${name} | Temp: ${temp}°C (${coords.x}, ${coords.y})`;
            }
        }

        function updateSimulation() {
            updatedFlags.fill(0);
            let particleCount = 0;

            for (let y = 0; y < HEIGHT; y++) {
                for (let x = 0; x < WIDTH; x++) {
                    const idx = y * WIDTH + x;
                    const id = grid[idx];

                    if (id === 0) continue;

                    particleCount++;
                    let t = tempGrid[idx];

                    if (id === 9) t = 500;
                    else if (id === 8) t = 1000;
                    else if (id === 7) t = -10;
                    else if (id === 10) t = -196;

                    if (x > 0) t += (tempGrid[idx - 1] - t) * 0.04;
                    if (x < WIDTH - 1) t += (tempGrid[idx + 1] - t) * 0.04;
                    if (y > 0) t += (tempGrid[idx - WIDTH] - t) * 0.04;
                    if (y < HEIGHT - 1) t += (tempGrid[idx + WIDTH] - t) * 0.04;

                    if (id === 6 && t <= 0) grid[idx] = 7;
                    else if (id === 7 && t >= 0) grid[idx] = 6;
                    else if (id === 6 && t >= 100) grid[idx] = 64;
                    else if (id === 71 && t >= 300) grid[idx] = 9;

                    tempGrid[idx] = t;
                }
            }

            for (let y = HEIGHT - 1; y >= 0; y--) {
                const leftToRight = (y % 2 === 0);

                for (let i = 0; i < WIDTH; i++) {
                    const x = leftToRight ? i : (WIDTH - 1 - i);
                    const idx = y * WIDTH + x;
                    const id = grid[idx];

                    if (id === 0 || updatedFlags[idx]) continue;

                    const type = TYPE_MAP[id];

                    if (type === 7) {
                        const neighbors = [
                            y > 0 ? idx - WIDTH : -1,
                            y < HEIGHT - 1 ? idx + WIDTH : -1,
                            x > 0 ? idx - 1 : -1,
                            x < WIDTH - 1 ? idx + 1 : -1
                        ];

                        let dissolved = false;

                        for (const nIdx of neighbors) {
                            if (nIdx !== -1 && grid[nIdx] !== 0 && grid[nIdx] !== 7 && grid[nIdx] !== 51) {
                                grid[nIdx] = 0;
                                dissolved = true;
                                break;
                            }
                        }

                        const below = y + 1 < HEIGHT ? idx + WIDTH : -1;

                        if (below !== -1 && grid[below] === 0) {
                            grid[below] = id;
                            tempGrid[below] = tempGrid[idx];
                            grid[idx] = 0;
                            updatedFlags[below] = 1;
                        } else if (dissolved) {
                            grid[idx] = 0;
                        }
                    } else if (type === 2) {
                        const below = y + 1 < HEIGHT ? idx + WIDTH : -1;

                        if (below !== -1 && (grid[below] === 0 || TYPE_MAP[grid[below]] === 3)) {
                            const target = grid[below];
                            grid[below] = id;
                            tempGrid[below] = tempGrid[idx];
                            grid[idx] = target;
                            updatedFlags[below] = 1;
                        } else {
                            const dir = Math.random() < 0.5 ? -1 : 1;
                            const diag = (y + 1 < HEIGHT && x + dir >= 0 && x + dir < WIDTH)
                                ? idx + WIDTH + dir
                                : -1;

                            if (diag !== -1 && grid[diag] === 0) {
                                grid[diag] = id;
                                tempGrid[diag] = tempGrid[idx];
                                grid[idx] = 0;
                                updatedFlags[diag] = 1;
                            }
                        }
                    } else if (type === 3 || type === 9) {
                        const below = y + 1 < HEIGHT ? idx + WIDTH : -1;

                        if (below !== -1 && grid[below] === 0) {
                            grid[below] = id;
                            tempGrid[below] = tempGrid[idx];
                            hpGrid[below] = hpGrid[idx];
                            grid[idx] = 0;
                            updatedFlags[below] = 1;
                        } else {
                            const dir = Math.random() < 0.5 ? -1 : 1;
                            const side = (x + dir >= 0 && x + dir < WIDTH) ? idx + dir : -1;

                            if (side !== -1 && grid[side] === 0) {
                                grid[side] = id;
                                tempGrid[side] = tempGrid[idx];
                                hpGrid[side] = hpGrid[idx];
                                grid[idx] = 0;
                                updatedFlags[side] = 1;
                            }
                        }
                    } else if (type === 4) {
                        const above = y > 0 ? idx - WIDTH : -1;

                        if (above !== -1 && grid[above] === 0) {
                            grid[above] = id;
                            tempGrid[above] = tempGrid[idx];
                            grid[idx] = 0;
                            updatedFlags[above] = 1;
                        }
                    } else if (type === 5) {
                        const above = y > 0 ? idx - WIDTH : -1;

                        if (above !== -1 && grid[above] === 0) {
                            grid[above] = id;
                            tempGrid[above] = 500;
                            grid[idx] = 0;
                            updatedFlags[above] = 1;
                        } else if (Math.random() < 0.3) {
                            grid[idx] = 0;
                        }
                    } else if (type === 6) {
                        const below = y + 1 < HEIGHT ? idx + WIDTH : -1;
                        const hasGround = below !== -1 && grid[below] !== 0 && TYPE_MAP[grid[below]] !== 4;
                        const neighbors = [
                            y > 0 ? idx - WIDTH : -1,
                            y < HEIGHT - 1 ? idx + WIDTH : -1,
                            x > 0 ? idx - 1 : -1,
                            x < WIDTH - 1 ? idx + 1 : -1
                        ];

                        let hp = hpGrid[idx];

                        for (const nIdx of neighbors) {
                            if (nIdx !== -1 && (grid[nIdx] === 8 || grid[nIdx] === 9 || grid[nIdx] === 12 || tempGrid[nIdx] > 70)) {
                                hp -= 8;

                                const bloodTarget = y < HEIGHT - 1 ? idx + WIDTH : -1;

                                if (bloodTarget !== -1 && grid[bloodTarget] === 0) {
                                    grid[bloodTarget] = 5;
                                    tempGrid[bloodTarget] = 37;
                                }
                            }
                        }

                        hpGrid[idx] = hp;

                        if (hp <= 0) {
                            grid[idx] = 5;
                            continue;
                        }

                        if (!hasGround) {
                            if (below !== -1 && grid[below] === 0) {
                                grid[below] = id;
                                tempGrid[below] = tempGrid[idx];
                                hpGrid[below] = hp;
                                grid[idx] = 0;
                                updatedFlags[below] = 1;
                            }
                        } else {
                            const dir = Math.random() < 0.5 ? -1 : 1;
                            const side = (x + dir >= 0 && x + dir < WIDTH) ? idx + dir : -1;

                            if (side !== -1 && grid[side] === 0 && Math.random() < 0.5) {
                                grid[side] = id;
                                tempGrid[side] = tempGrid[idx];
                                hpGrid[side] = hp;
                                grid[idx] = 0;
                                updatedFlags[side] = 1;
                            }
                        }
                    }
                }
            }

            document.getElementById('particle-counter').innerText = particleCount;
        }

        const imgData = ctx.createImageData(WIDTH, HEIGHT);
        const buf = new Uint32Array(imgData.data.buffer);

        function render() {
            for (let i = 0; i < grid.length; i++) {
                const id = grid[i];

                if (heatViewActive) {
                    const temp = tempGrid[i];
                    let r = 0, g = 0, b = 255;

                    if (temp <= 0) {
                        r = 0; g = 150; b = 255;
                    } else if (temp < 60) {
                        const factor = temp / 60;
                        r = Math.floor(factor * 255);
                        g = Math.floor(255 * (1 - factor));
                        b = 100;
                    } else if (temp < 300) {
                        r = 255; g = 255; b = 0;
                    } else {
                        r = 255;
                        g = Math.max(0, 255 - Math.floor((temp - 300) / 4));
                        b = 0;
                    }

                    buf[i] = (255 << 24) | (b << 16) | (g << 8) | r;
                } else {
                    buf[i] = COLOR_CACHE[id];
                }
            }

            ctx.putImageData(imgData, 0, 0);
        }

        let lastTime = performance.now();
        let frameCount = 0;

        function mainLoop(now) {
            frameCount++;

            if (now - lastTime >= 1000) {
                document.getElementById('fps-counter').innerText = frameCount;
                frameCount = 0;
                lastTime = now;
            }

            if (!isPaused) updateSimulation();

            render();
            requestAnimationFrame(mainLoop);
        }

        populateElementList();
        requestAnimationFrame(mainLoop);
    </script>
</body>
</html>
